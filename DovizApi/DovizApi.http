@DovizApi_HostAddress = http://localhost:5054

### Yeni müşteri + Hesap Ek No 5001 TRY hesabı oluştur
POST {{DovizApi_HostAddress}}/api/v1/musteriler
Content-Type: application/json

{
  "ad": "Ahmet",
  "soyad": "Test",
  "subeKodu": "2324",
  "baslangicTryBakiyesi": 10000
}

### 005 kurulum verisindeki 100000 numaralı müşterinin hesapları
GET {{DovizApi_HostAddress}}/api/v1/musteriler/100000/hesaplar
Accept: application/json

### Sayfalı müşteri listesi
GET {{DovizApi_HostAddress}}/api/v1/musteriler?page=1&pageSize=20&arama=ahmet&subeKodu=2324
Accept: application/json

### Hızlı müşteri arama
GET {{DovizApi_HostAddress}}/api/v1/musteriler/ara?q=1000&limit=10
Accept: application/json

### Müşterinin tüm hesap hareketleri
GET {{DovizApi_HostAddress}}/api/v1/musteriler/100000/hesap-hareketleri
Accept: application/json

### Döviz ek hesabı aç
POST {{DovizApi_HostAddress}}/api/v1/musteriler/100000/hesaplar
Content-Type: application/json

{
  "dovizKodu": "EUR"
}

### Döviz çevir
POST {{DovizApi_HostAddress}}/api/v1/doviz-cevir
Content-Type: application/json

{
  "musteriId": 100000,
  "borcluHesapEkNo": 5002,
  "alacakliHesapEkNo": 5001,
  "odenecekDovizMiktari": 1000
}

### İşlemleri ve kaynak/hedef dövizleri getir
GET {{DovizApi_HostAddress}}/api/v1/doviz-islemleri-getir?page=1&pageSize=20
Accept: application/json

### Şubeye göre işlemleri getir
GET {{DovizApi_HostAddress}}/api/v1/doviz-islemleri-getir?page=1&pageSize=20&subeKodu=2324
Accept: application/json

### Referans numarasıyla işlem detayı
GET {{DovizApi_HostAddress}}/api/v1/doviz-islemleri/2324DOVS26000001
Accept: application/json

### İşlemi silmeden ters kayıtla iptal et
POST {{DovizApi_HostAddress}}/api/v1/doviz-islemleri/2324DOVS26000001/iptal
Content-Type: application/json

{
  "iptalNedeni": "Müşteri talebi"
}

### Şubeleri getir
GET {{DovizApi_HostAddress}}/api/v1/subeler
Accept: application/json

### Şube detayı
GET {{DovizApi_HostAddress}}/api/v1/subeler/2324
Accept: application/json

### Yeni şube oluştur
POST {{DovizApi_HostAddress}}/api/v1/subeler
Content-Type: application/json

{
  "kod": "2327",
  "ad": "İzmir Şubesi"
}
